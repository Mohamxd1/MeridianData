# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dataforge:dataforgepass@localhost:5432/dataforge
SYNC_DATABASE_URL=postgresql+psycopg://dataforge:dataforgepass@localhost:5432/dataforge

# ── Redis / Queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATAFORGE_QUEUE_MODE=background
# Set to "rq" in production for durable background jobs

# ── File storage ──────────────────────────────────────────────────────────────
DATAFORGE_STORAGE_BACKEND=local
# Options: local | s3 | r2

# AWS S3 (if DATAFORGE_STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dataforge-files
AWS_S3_REGION=us-east-1

# Cloudflare R2 (if DATAFORGE_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dataforge-files

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=
# Generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
# Get from: sentry.io → new project → Python → copy DSN

# ── Analytics ────────────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ── App settings ──────────────────────────────────────────────────────────────
DATAFORGE_CORS_ORIGINS=http://localhost:5173
DATAFORGE_MAX_JSON_BODY_BYTES=1048576
DATAFORGE_STARTUP_RECOVERY_STRATEGY=fail
# Options: fail | requeue
DATAFORGE_RATE_LIMIT_ENABLED=true
DATAFORGE_DEV_MODE=false
# Set true in local dev only — disables demo_client auth check

# ── Seed (local dev only) ─────────────────────────────────────────────────────
DATAFORGE_SEED_ON_START=false
DATAFORGE_DEMO_CLIENT_ID=demo_client
DATAFORGE_DEMO_OWNER_EMAIL=admin@demo.dataforge.io
DATAFORGE_DEMO_OWNER_PASSWORD=
# Must be set explicitly — never use a default password
